        <mxCell id="note2" value="HealthKit importa ieraksts papildina uzskaites ierakstu ar avota identitāti. Personas piekļuvi nosaka sesija un tiesības; administrēšana neietver veselības mērījumus." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontColor=#18263b;fontSize=23;">
